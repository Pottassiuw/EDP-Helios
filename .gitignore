# Dependências
node_modules/
.venv/
backend/venv/

# Credenciais do robô SAP (nunca versionar login/senha reais)
backend/credenciais.json

# Variáveis de ambiente / segredos (Databricks token, etc.)
# O sufixo cobre cópias de segurança (.env.bak, .env.local): elas carregam o
# mesmo token e antes escapavam do ignore por não casarem com o nome exato.
backend/.env
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc

# Build do frontend (gerado por `npm run build`)
frontend/dist/

# Estado de runtime do backend
backend/app_state.json

# Dados locais do módulo Input
backend/data/

# Sessões de brainstorm (visual companion)
.superpowers/

# Worktrees isolados (subagent-driven-development)
.worktrees/

# Graphify: manter saídas portáveis; ignorar cache e caminhos da máquina
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.vocab.txt

# Estado local do Helios Delivery Orchestrator
.helios/
delivery-graph.json
